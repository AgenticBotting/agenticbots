# ═══════════════════════════════════════════════════════════════════════
# AgenticBots — STAGING settings (your computer only; never committed).
#   cp .env.staging.example .env.staging   then fill in the blanks.
# Used by:  npm run staging        (the app, on http://localhost:3004)
#           npm run ops:staging -- …  (the provisioning CLI)
# Nothing in this file touches production.
# ═══════════════════════════════════════════════════════════════════════

# ─── Mode (do not change) ──────────────────────────────────────────────
DEMO_MODE=false
PLATFORM_ENV=staging

# ─── Staging database: the SEPARATE Convex project "agenticbots-staging" ─
# Convex dashboard → agenticbots-staging → Settings → URL & Deploy Key → "Deployment URL"
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
# 32+ random characters (generate: openssl rand -hex 32). Set the SAME value
# on the staging Convex deployment (see the runbook).
PLATFORM_SERVER_SECRET=

# Where you open the app (used in one-time sign-in links).
OPS_URL=http://localhost:3004
NEXT_PUBLIC_SITE_URL=http://localhost:3004
PASSKEY_ORIGIN=http://localhost:3004
# Use a separate, user-scoped, short-lived code from a secret manager to
# enroll a staff member's first passkey. Leave blank until the ceremony.
STAFF_ENROLLMENT_USER_ID=
STAFF_ENROLLMENT_TOKEN=
STAFF_ENROLLMENT_EXPIRES_AT=

# ─── AWS ───────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# The AWS CLI profile you created with `aws configure sso` (see the runbook).
AWS_PROFILE=agenticbots-staging
# Printed by `npm run ops:staging -- env:apply`.
AWS_LIFECYCLE_DOCUMENT=AgenticBots-RuntimeLifecycle-staging
ARTIFACT_BUCKET=
# Leave EMPTY on your computer (your AWS_PROFILE is used). Only Vercel uses it.
AWS_ROLE_ARN=

# ─── Cloudflare (private connection to the runtime) ────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# The domain you added to Cloudflare ITSELF, e.g. agenticbots-runtime.com
# (runtimes get <tenant-id>.<this domain>). Do not use a sub-subdomain like
# runtime.example.com: Cloudflare's free certificate only covers *.example.com.
RUNTIME_DOMAIN=

# ─── Runtime versions ──────────────────────────────────────────────────
RUNTIME_PROVIDER=hermes
RUNTIME_ENGINE_VERSION=v2026.9.24
RUNTIME_BUNDLE_VERSION=1.0.0

# Never put ALLOW_CLOUD_CHANGES=1 here — set it on the single command that
# needs it:  ALLOW_CLOUD_CHANGES=1 npm run ops:staging -- …
