# ═══════════════════════════════════════════════════════════════════════
# AgenticBots — environment variables
# Copy to .env.local for local development. Never commit real values.
# In Vercel: Project → Settings → Environment Variables.
# Stripe is NOT required anywhere. Billing is manual (ACH / wire / check).
# ═══════════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://agenticbots.dev
# Hosts for the authenticated product (optional until domains are attached).
OPS_HOST=ops.agenticbots.dev
APP_HOST=app.agenticbots.dev

# ─── Demo ──────────────────────────────────────────────────────────────
# true = seeded fictional data, demo runtime, no external calls at all.
DEMO_MODE=false
# Keep demo changes across dev-server restarts (local only).
DEMO_PERSIST=true

# ─── Environment ───────────────────────────────────────────────────────
# production | staging   (ignored when DEMO_MODE=true)
PLATFORM_ENV=production

# ─── Database (Convex — already used by this site) ─────────────────────
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=
# 32+ random characters. Set the SAME value on the Convex deployment:
#   npx convex env set PLATFORM_SERVER_SECRET <value>
PLATFORM_SERVER_SECRET=

# ─── Auth ──────────────────────────────────────────────────────────────
# Platform sign-in is built in (email + password, server-side sessions).
# Nothing to configure. First superadmin: see docs/BEGINNER_SETUP.md.

# ─── Background sync ───────────────────────────────────────────────────
# Vercel Cron calls /api/internal/sync every minute with this bearer token.
CRON_SECRET=

# ─── AWS (no static keys — Vercel OIDC federation) ─────────────────────
AWS_REGION=us-east-1
# Output `control_plane_role_arn` from Terraform.
AWS_ROLE_ARN=
AWS_LIFECYCLE_DOCUMENT=AgenticBots-RuntimeLifecycle
# Provisioning CLI only (your computer, not Vercel):
ARTIFACT_BUCKET=
# Real cloud changes from the CLI require this to be 1 for that command.
ALLOW_CLOUD_CHANGES=0

# ─── Cloudflare (private runtime connectivity; CLI only) ───────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# A zone on Cloudflare; runtimes get <tenant-id>.<RUNTIME_DOMAIN>. Use the
# zone apex (Cloudflare's free certificate covers one level: *.zone).
RUNTIME_DOMAIN=

# ─── Runtime ───────────────────────────────────────────────────────────
RUNTIME_ENGINE_VERSION=v2026.9.24
RUNTIME_BUNDLE_VERSION=1.0.0
# Staging/dev only: reach a runtime directly instead of via Secrets Manager.
# RUNTIME_DEV_TARGETS={"<runtimeId>":{"baseUrl":"http://127.0.0.1:8642","keys":{"seo":"<profile key>"}}}
RUNTIME_DEV_TARGETS=

# ─── Billing ───────────────────────────────────────────────────────────
DEFAULT_BILLING_GRACE_DAYS=7
DEFAULT_PAYMENT_TERMS_DAYS=5
DEFAULT_AUTO_SUSPEND=false
DEFAULT_AUTO_REACTIVATE=false

# ─── Marketing site (unchanged) ────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=hello@agenticbots.dev
CONTACT_EMAIL=hello@agenticbots.dev
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_URL=
UMAMI_WEBSITE_ID=
