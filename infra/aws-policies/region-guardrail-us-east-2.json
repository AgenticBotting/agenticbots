{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRegionalServicesOutsideOhioAndGlobalSupport",
      "Effect": "Deny",
      "NotAction": [
        "account:*",
        "artifact:*",
        "aws-portal:*",
        "budgets:*",
        "ce:*",
        "cloudfront:*",
        "cur:*",
        "ec2:DescribeRegions",
        "health:*",
        "iam:*",
        "networkmanager:*",
        "organizations:*",
        "pricing:*",
        "route53:*",
        "route53domains:*",
        "s3:GetAccountPublicAccessBlock",
        "s3:ListAllMyBuckets",
        "s3:ListMultiRegionAccessPoints",
        "s3:PutAccountPublicAccessBlock",
        "shield:*",
        "sts:*",
        "support:*",
        "supportapp:*",
        "supportplans:*",
        "tag:GetResources",
        "tax:*",
        "trustedadvisor:*",
        "waf:*",
        "waf-regional:*",
        "wafv2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-2",
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "LimitVirginiaToGlobalWafAndItsLogs",
      "Effect": "Deny",
      "NotAction": [
        "account:*",
        "artifact:*",
        "aws-portal:*",
        "budgets:*",
        "ce:*",
        "cloudfront:*",
        "cur:*",
        "ec2:DescribeRegions",
        "health:*",
        "iam:*",
        "logs:*",
        "networkmanager:*",
        "organizations:*",
        "pricing:*",
        "route53:*",
        "route53domains:*",
        "s3:GetAccountPublicAccessBlock",
        "s3:ListAllMyBuckets",
        "s3:ListMultiRegionAccessPoints",
        "s3:PutAccountPublicAccessBlock",
        "shield:*",
        "sts:*",
        "support:*",
        "supportapp:*",
        "supportplans:*",
        "tag:GetResources",
        "tax:*",
        "trustedadvisor:*",
        "waf:*",
        "waf-regional:*",
        "wafv2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
