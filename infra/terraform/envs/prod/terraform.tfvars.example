# Copy to terraform.tfvars (git-ignored) and fill in.
region               = "us-east-1"
vercel_team_slug     = "your-team"
vercel_project_name  = "agenticbots"
artifact_bucket      = "agenticbots-prod-artifacts-REPLACE"
alarm_email          = "ops@agenticbots.dev"
# Resolve the digest with: docker buildx imagetools inspect nousresearch/hermes-agent:v2026.9.24
default_engine_image = "nousresearch/hermes-agent:v2026.9.24@sha256:REPLACE_WITH_64_HEX_DIGEST_FROM_IMAGETOOLS_INSPECT_0000000000"
